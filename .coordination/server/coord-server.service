[Unit]
Description=HUAKAI multi-AI edit coordination service
Documentation=https://github.com/BloomingProsperity/HUAKAI .coordination/server/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# COORD_TOKEN (shared secret) + COORD_BIND/PORT/DB/TTL live here (chmod 600):
EnvironmentFile=/etc/huakai-coord.env
ExecStart=/usr/bin/python3 /opt/huakai-coord/coord_server.py
Restart=always
RestartSec=2
User=coord
Group=coord

# hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/huakai-coord

[Install]
WantedBy=multi-user.target
