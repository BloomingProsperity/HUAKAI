# 每日运维巡检邮件默认关闭；启用后只读取部署者平台租户，并复用管理员通知邮箱。
# HUAKAI_DAILY_OPS_INSPECTION_ENABLED=false
# HUAKAI_DAILY_OPS_INSPECTION_INTERVAL=24h
# HUAKAI_ADMIN_NOTIFICATION_EMAIL=ops@example.com
# Hermes runner 本地联调。先运行：
#   ./deploy/hermes-runner/generate-keypair.sh ./deploy/hermes-runner/dev-keys
# 内部令牌密钥必须使用随机值，不能提交真实值。
# 本地手动跑 gateway 时,quota reconciler 默认启用;需临时停用才设 HUAKAI_QUOTA_RECONCILER_ENABLED=false。
# 本地手动跑 gateway 时,告警规则评估器默认启用(unset/非法值均按 true);无告警规则时空转 no-op。
# dev 便于本地联调;需临时停用才设 HUAKAI_ALERTING_EVAL_ENABLED=false。
# 本地手动跑 gateway 时,内容审核执行器默认启用(unset/非法值均按 true);租户级审核配置默认 Enabled=false。
# 未在 admin 面显式开启审核的租户仍放行;整机临时停用才设 HUAKAI_CONTENT_MODERATION_ENABLED=false。
# 持久结算意图默认关闭；本地迁移到 0175 后可设 HUAKAI_SETTLEMENT_INTENT_ENABLED=true 联调。
HUAKAI_HERMES_RUNNER_URL=http://localhost:8801
HUAKAI_HERMES_INTERNAL_TOKEN_SECRET=replace-with-a-random-internal-token-secret
HUAKAI_HERMES_MCP_URL=http://localhost:8080/internal/hermes/mcp
HUAKAI_HERMES_JWT_PRIVATE_KEY_PATH=./deploy/hermes-runner/dev-keys/private.pem
HUAKAI_HERMES_JWT_PUBLIC_KEY_PATH=./deploy/hermes-runner/dev-keys/public.pem
HUAKAI_HERMES_JWT_KID=dev-local
