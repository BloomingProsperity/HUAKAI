# Hermes runner 开发环境占位值。
# 复制到本地 env 文件或运行 compose 前 export，不能提交真实 secret。
HUAKAI_HERMES_RUNNER_URL=http://localhost:8801
HUAKAI_HERMES_INTERNAL_SHARED_SECRET=replace-me-internal-route-secret
HUAKAI_HERMES_JWT_PRIVATE_KEY_PATH=./deploy/hermes-runner/dev-keys/dev_jwt_private.pem
HUAKAI_HERMES_JWT_PUBLIC_KEY_PATH=./deploy/hermes-runner/dev-keys/dev_jwt_public.pem
HUAKAI_HERMES_JWT_KID=dev-local
