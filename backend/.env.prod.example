# HUAKAI 生产环境变量样例(配合 docker-compose.prod.yml)。
# 复制为 .env 并填入真实值;**切勿把填好真值的 .env 或任何私钥提交进仓库**。
# config.Load 只读 env(不读 YAML);缺关键 env 启动 fail-loud 拒启。
#
# 生成密钥(把输出填到对应变量;每个部署生成各自独立的值):
#   HUAKAI_CREDENTIAL_KEY_B64      : openssl rand -base64 32
#   HUAKAI_SESSION_SIGNING_KEY_B64 : openssl rand -base64 32
#   HUAKAI_ADMIN_BOOTSTRAP_TOKEN   : printf 'hk_admin_%s' "$(head -c15 /dev/urandom | base32 | tr -d '=' | tr 'a-z' 'A-Z' | head -c24)"
#   POSTGRES_PASSWORD              : openssl rand -base64 24 | tr -d '=+/'
#   审计私钥(ed25519 PEM,见 HUAKAI_AUDIT_PRIVATE_KEY_HOST):
#     mkdir -p secrets && openssl genpkey -algorithm ed25519 -out secrets/audit_key.pem

# ---- 数据库 ----
# DSN 里的 host 用 compose 服务名 postgres;密码须与 POSTGRES_PASSWORD 一致。
HUAKAI_DATABASE_URL=postgres://huakai:CHANGE_ME_PG_PASSWORD@postgres:5432/huakai?sslmode=disable
POSTGRES_PASSWORD=CHANGE_ME_PG_PASSWORD

# ---- 加密 / 会话 / 引导 ----
# 32 字节 base64 凭据加密 key。
HUAKAI_CREDENTIAL_KEY_B64=CHANGE_ME_BASE64_32B
# JWT session 签名 key(base64);或改用 HUAKAI_SESSION_SIGNING_KEY_HEX(>=32 字节 hex)。
HUAKAI_SESSION_SIGNING_KEY_B64=CHANGE_ME_BASE64_32B
# 首次启动(admin_tokens 空时)的一次性 bootstrap 管理员令牌,形状必须为
# hk_admin_<24位base32>(共 33 字符);首次用后请轮换。
HUAKAI_ADMIN_BOOTSTRAP_TOKEN=hk_admin_CHANGE_ME_24CHAR_BASE32

# ---- 发布模式 ----
# 生产部署必须为 production(会启用多道启动安全门:见 docs/deploy/production-bootstrap.md)。
HUAKAI_RELEASE_MODE=production

# ---- 审计(production 模式硬要求)----
# 审计账本后端:production 必须为 postgres(持久化)。
HUAKAI_AUDIT_LEDGER_BACKEND=postgres
# 宿主上 ed25519 审计私钥文件路径(compose 只读挂载进容器);默认 ./secrets/audit_key.pem。
HUAKAI_AUDIT_PRIVATE_KEY_HOST=./secrets/audit_key.pem

# ---- 可选 ----
# 注册模式:production 默认 disabled。需开放自助注册才设(open / invite_required / admin_only)。
# HUAKAI_USER_REGISTRATION_MODE=disabled
# 监听地址(默认 :8080)。
# HUAKAI_ADDR=:8080
