# HUAKAI 生产环境变量样例(配合 docker-compose.prod.yml)。
# 复制为 .env 并填入真实值;**切勿把填好真值的 .env 或任何私钥提交进仓库**。
# config.Load 只读 env(不读 YAML);缺关键 env 启动 fail-loud 拒启。
#
# 生成密钥(把输出填到对应变量;每个部署生成各自独立的值):
#   HUAKAI_CREDENTIAL_KEY_B64      : openssl rand -base64 32
#   HUAKAI_SESSION_SIGNING_KEY_B64 : openssl rand -base64 32
#   HUAKAI_ADMIN_BOOTSTRAP_TOKEN   : printf 'hk_admin_%s' "$(head -c15 /dev/urandom | base32 | tr -d '=' | tr 'a-z' 'A-Z' | head -c24)"
#   POSTGRES_PASSWORD              : openssl rand -base64 24 | tr -d '=+/'
#   审计私钥(ed25519 PEM,见 HUAKAI_AUDIT_PRIVATE_KEY_HOST):
#     mkdir -p secrets && openssl genpkey -algorithm ed25519 -out secrets/audit_key.pem

# ---- 数据库 ----
# DSN 里的 host 用 compose 服务名 postgres;密码须与 POSTGRES_PASSWORD 一致。
HUAKAI_DATABASE_URL=postgres://huakai:CHANGE_ME_PG_PASSWORD@postgres:5432/huakai?sslmode=disable
POSTGRES_PASSWORD=CHANGE_ME_PG_PASSWORD

# ---- 加密 / 会话 / 引导 ----
# 32 字节 base64 凭据加密 key。
HUAKAI_CREDENTIAL_KEY_B64=CHANGE_ME_BASE64_32B
# JWT session 签名 key(base64);或改用 HUAKAI_SESSION_SIGNING_KEY_HEX(>=32 字节 hex)。
HUAKAI_SESSION_SIGNING_KEY_B64=CHANGE_ME_BASE64_32B
# 首次启动(admin_tokens 空时)的一次性 bootstrap 管理员令牌,形状必须为
# hk_admin_<24位base32>(共 33 字符);首次用后请轮换。
HUAKAI_ADMIN_BOOTSTRAP_TOKEN=hk_admin_CHANGE_ME_24CHAR_BASE32
# (可选)role 制单登录:把此邮箱对应的、已在默认工作租户注册的账号提升为 role=admin(管理面板)。
# 先用正常注册流建账号,再设此 env 重启即提升;账号不存在/已是 admin 都不影响启动。留空=不启用。
# HUAKAI_ADMIN_BOOTSTRAP_EMAIL=ops@your-domain.example

# ---- 发布模式 ----
# 生产部署必须为 production（会启用多道启动安全门，见 docs/deploy/生产部署与升级.md）。
HUAKAI_RELEASE_MODE=production

# ---- 跨实例公网限流 ----
# compose 默认使用内置 redis 服务；外部 Redis 可在这里覆盖。production 缺失会拒绝启动。
HUAKAI_RATE_LIMIT_REDIS_URL=redis://redis:6379/0

# ---- 审计(production 模式硬要求)----
# 审计账本后端:production 必须为 postgres(持久化)。
HUAKAI_AUDIT_LEDGER_BACKEND=postgres
# 宿主上 ed25519 审计私钥文件路径(compose 只读挂载进容器);默认 ./secrets/audit_key.pem。
HUAKAI_AUDIT_PRIVATE_KEY_HOST=./secrets/audit_key.pem

# ---- 反向代理 / HTTPS(Caddy 自动 TLS)----
# 你的公网域名:Caddy 据此自动签发并续期 Let's Encrypt 证书(零证书运维)。
# 上线前须:① 把该域名 A/AAAA 记录解析到本机公网 IP;② 放行入站 80 与 443。
# 本地联调无公网域名时可填 localhost(Caddy 发本地自签证书,浏览器会提示不受信,仅供联调)。
HUAKAI_PUBLIC_DOMAIN=api.example.com
# 信任反代转发的 X-Forwarded-For 的来源(CSV CIDR),使 per-IP 限流按真实客户端 IP 计算。
# 默认全部 RFC1918 私网段(gateway 仅 compose 内网可达,能连它的只有同网 caddy,外部无从伪造)。
# 通常无需改;仅当前面再叠一层 CDN/LB(如 Cloudflare)时,按需缩成那一层的出口网段。
HUAKAI_TRUSTED_PROXY_CIDRS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# ---- 可选 ----
# quota reconciler 默认启用(unset/非法值均按 true),用于补偿结算/释放失败和孤儿预留。
# 仅应急停用时显式设 false 或 0。
# HUAKAI_QUOTA_RECONCILER_ENABLED=true
# 持久结算意图默认关闭；完成迁移 0175 后可灰度开启，写失败只告警、不阻断 relay。
# HUAKAI_SETTLEMENT_INTENT_ENABLED=false
# CRS 账号来源同步默认关闭。启用时只填写允许访问的主机名(CSV，不带 scheme/端口/路径)；
# 每次拨号均经 Rust sidecar 重新解析、校验并固定目标 IP。生产公网来源保持私网访问关闭。
# HUAKAI_CRS_SOURCE_ALLOWED_HOSTS=crs.example.com
# HUAKAI_CRS_SOURCE_ALLOW_PRIVATE_HOSTS=false
# 告警规则评估器默认启用(unset/非法值均按 true):无告警规则时评估循环空转 no-op,
# LeaderLock 已防多副本重复。配了告警规则却不评估会静默失效,故默认开;应急停用设 false/0。
# HUAKAI_ALERTING_EVAL_ENABLED=true
# 内容审核执行器默认启用(unset/非法值均按 true):执行器恒接线,但**租户级审核配置默认
# Enabled=false**——未在 admin 面显式开启审核的租户仍全量放行,翻开只是让 admin PUT
# enabled=true 从此真生效(与成熟中转站"执行器常在+配置默认关"同语义)。整机应急停用设 false/0。
# HUAKAI_CONTENT_MODERATION_ENABLED=true
# 内置服务器实例监测默认开启；30 秒采集，90 秒无活动判离线，历史固定保留 30 天。
# 单实例可留空节点 ID，API 会如实标记运行环境摘要身份不稳定；多副本必须给每个副本设置
# 唯一且稳定的 3-64 位小写 opaque slug，禁止填写会泄漏主机信息的 IP 或真实主机名。
# HUAKAI_SERVER_MONITOR_ENABLED=true
# HUAKAI_SERVER_MONITOR_NODE_ID=edge-cn-01
# HUAKAI_SERVER_MONITOR_DISPLAY_NAME=华东网关 1
# HUAKAI_SERVER_MONITOR_INTERVAL=30s
# HUAKAI_SERVER_MONITOR_OFFLINE_AFTER=90s
# 客户 API key 前缀 base:默认 hk(签发 hk_live_/hk_test_、入站只认这两前缀)。
# 想让 key 兼容只认特定前缀的客户端 SDK 时改(仅小写字母+数字、1-6 字符,非法值启动报错;越短索引选择性越好)。
# 签发与入站校验同源,改它即同时生效两端;admin 前缀 hk_admin_ 不可配(权限边界)。
# HUAKAI_API_KEY_PREFIX=hk
# budget 后端故障取舍:默认 false=fail-open(budget 基础设施故障时放行,不阻断业务)。
# 设 true=fail-close,故障即拒绝(quota 安全优先,可能误拒)。仅额度强一致诉求时设。
# HUAKAI_BUDGET_FAIL_CLOSED=false
# 注册模式:production 默认 disabled。需开放自助注册才设(open / invite_required / admin_only)。
# HUAKAI_USER_REGISTRATION_MODE=disabled
# 邮箱门:production 默认软化(未配 SMTP 也能起,验证邮件功能请求时惰性失败,注册按"验证关闭"放行)。
# 设 true 恢复旧严格行为:每个 active 租户必须配齐 SMTP 且开启邮箱验证才放行启动。
# HUAKAI_REQUIRE_EMAIL_GATE=false
# 第三方登录(社交登录 / OAuth):默认不启用。每个部署方到上游注册自己的 OAuth 应用、用自己的凭证;
# 回调地址填 https://<你的域名>/oauth/callback，须与上游登记的一字不差。详见 docs/deploy/生产部署与升级.md。
# 推荐改用管理台「设置中心 →注册登录」分组配置(即时生效、免重启、密钥脱敏);下面 env 是免 UI 的等价回退。
# 授权/令牌端点与 scope 有内置默认(GitHub read:user user:email;Google openid email profile),通常不用设。
# HUAKAI_GITHUB_OAUTH_CLIENT_ID=
# HUAKAI_GITHUB_OAUTH_CLIENT_SECRET=
# HUAKAI_GITHUB_OAUTH_REDIRECT_URI=https://<你的域名>/oauth/callback
# HUAKAI_GOOGLE_OAUTH_CLIENT_ID=
# HUAKAI_GOOGLE_OAUTH_CLIENT_SECRET=
# HUAKAI_GOOGLE_OAUTH_REDIRECT_URI=https://<你的域名>/oauth/callback
# Antigravity 反转车道(experimental,默认关)：client_id/secret 默认用内置公开 native-app 凭据，
# 开箱即用。运营者若想换成自己注册的 OAuth 客户端(避开与其它部署共用同一 client)，可经下面两项 override。
# HUAKAI_ANTIGRAVITY_OAUTH_CLIENT_ID=<你的 antigravity OAuth client_id>
# HUAKAI_ANTIGRAVITY_OAUTH_CLIENT_SECRET=<你的 antigravity OAuth client_secret>
# 进程内自迁移:默认关(迁移由 compose 的 migrate one-shot 外置跑)。compose 部署无需改。
# 仅裸二进制单实例想省去手动迁移步骤时设 true(与外置共用同表、幂等、advisory lock 防竞态)。
# HUAKAI_AUTO_MIGRATE=false
# relay 容量上限(MB 单位):入站请求体上限,默认 32(旧版硬写 1MiB 会把带图/长上下文请求 413)。
# 作用范围:聊天/responses/messages 主链(/v1/chat/completions、/v1/responses、/v1/messages)
# + 全局 privacy 解析缓冲(仅 relay 路径)。/v1/images、/v1/embeddings、/v1/audio 等媒体端点
# 各自有独立的逐端点上限(2~25MiB 不等),不受此 env 调整——它们的可配化是单独 follow-up。
# HUAKAI_MAX_REQUEST_BODY_MB=32
# 上游 SSE 单事件扫描缓冲上限,默认 16(钳到 ≤64MiB),防大单事件(大 tool-call/Gemini 大块)被砍流。
# HUAKAI_MAX_SSE_EVENT_MB=16
# Rust 出口默认按 profile 的真实 ALPN 工作。仅在定位上游 H2 兼容故障时临时
# 显式收窄到 HTTP/1.1；非法布尔值会阻止启动，避免误以为开关已生效。
# HUAKAI_TRANSPORT_FORCE_H1=false
# 每日运维巡检邮件默认关闭；启用后只读取部署者平台租户，并复用管理员通知邮箱。
# HUAKAI_DAILY_OPS_INSPECTION_ENABLED=false
# HUAKAI_DAILY_OPS_INSPECTION_INTERVAL=24h
# HUAKAI_ADMIN_NOTIFICATION_EMAIL=ops@example.com
# Hermes 运维助手默认关闭。启用步骤：
# 1. `./deploy/hermes-runner/generate-keypair.sh ./secrets/hermes`
# 2. 生成独立随机内部令牌密钥；3. 取消下面配置注释；
# 4. `docker compose -f docker-compose.prod.yml --profile hermes up -d`。
# runner 只有 HUAKAI 内网，没有宿主端口和公网；普通用户没有 Hermes 权限。
# HUAKAI_HERMES_RUNNER_URL=http://hermes-runner:8801
# HUAKAI_HERMES_KEYS_HOST_DIR=./secrets/hermes
# HUAKAI_HERMES_JWT_KID=compose-hermes
# HUAKAI_HERMES_INTERNAL_TOKEN_SECRET=<至少 32 字节随机值>
# HUAKAI_HERMES_LLM_TOOLLOOP_ENABLED=true
# HUAKAI_HERMES_LLM_PROPOSE_ENABLED=false
# HUAKAI_HERMES_MUTATING_ENABLED=true
# HUAKAI_HERMES_MAX_CONCURRENCY=1
# 监听地址(默认 :8080)。
# HUAKAI_ADDR=:8080
