# HUAKAI production env — EXAMPLE. Copy to .env.prod and fill real values, OR just
# run `./deploy/gen-secrets.sh` which generates .env.prod + the audit key for you.
# .env.prod itself is gitignored (it holds real secrets) — never commit it.
#
# Generate the random secrets with:
#   openssl rand -hex 24      # POSTGRES_PASSWORD (URL-safe hex)
#   openssl rand -base64 32   # HUAKAI_CREDENTIAL_KEY_B64 (32 bytes)
#   openssl rand -base64 48   # HUAKAI_SESSION_SIGNING_KEY_B64 (>=32 bytes)
#   echo "hk_admin_$(openssl rand -hex 24)"   # HUAKAI_ADMIN_BOOTSTRAP_TOKEN
#   openssl genpkey -algorithm ed25519 -out deploy/keys/audit_ed25519.key   # audit signer

# Postgres superuser password (also embedded in the DSN below).
POSTGRES_PASSWORD=change-me-postgres-password

# Gateway DSN — host is the compose service name `postgres`.
HUAKAI_DATABASE_URL=postgres://huakai:change-me-postgres-password@postgres:5432/huakai?sslmode=disable

# 32-byte base64 key for upstream-credential encryption at rest.
HUAKAI_CREDENTIAL_KEY_B64=change-me-32-byte-base64

# >=32-byte base64 session/JWT signing key (or use HUAKAI_SESSION_SIGNING_KEY_HEX).
HUAKAI_SESSION_SIGNING_KEY_B64=change-me-48-byte-base64

# One-time admin bootstrap token (hk_admin_ prefix). Rotate after first login.
HUAKAI_ADMIN_BOOTSTRAP_TOKEN=hk_admin_change-me

# Must be `production` for a real deployment (enables the postgres audit ledger
# + signed-receipt gate, which is why the audit key below is required).
HUAKAI_RELEASE_MODE=production

# Self-service registration is OFF by default in production. To let users sign up,
# set to `open` (anyone) or `invite_required` (invite code needed).
HUAKAI_USER_REGISTRATION_MODE=disabled

# The audit signing key is NOT an env value — it is a file mounted at
# /run/secrets/keys/audit_ed25519.key by the compose (from backend/deploy/keys/).
# deploy/gen-secrets.sh writes it; HUAKAI_AUDIT_PRIVATE_KEY_PATH + the postgres
# ledger backend are already wired in docker-compose.prod.yml.
