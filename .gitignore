# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors / IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json.example
*.swp
*.swo

# Local agent / CLI state (must never be committed)
.claude/settings.local.json
.gemini/settings.local.json
.codex/local/

# Go test/build caches pinned by backend/scripts/run-go-test.* (Defender-
# excluded paths used to dodge SAC/AppLocker blocks; see
# docs/01_APPLOCKER_DEFENDER_RESOLUTION.md). Each can hit ~150 MB; never commit.
backend/.tmp/
backend/.gotmp/
backend/.gocache/

# Secrets & env
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/
credentials.json

# Build output (placeholder for future phases)
dist/
build/
out/
target/
bin/
*.exe
*.bin
*.test
node_modules/
vendor/
.venv/
__pycache__/
*.pyc

# Generated code (sqlc).
# NOTE: We track sqlc-generated files at backend/internal/db/ so a fresh
# clone compiles without requiring `make generate` (sqlc binary install
# can be flaky behind some networks). Regenerate via `make generate`
# whenever a sql/queries/*.sql file changes; commit the diff together
# with the SQL change.

# Operator config (never commit; only config.example.yaml is tracked)
backend/config.yaml
!backend/config.example.yaml

# Frontend build artifacts (Phase 7+)
frontend/node_modules/
frontend/dist/
frontend/.next/
frontend/build/

# Logs & runtime
*.log
logs/
tmp/
temp/

# Coverage / test artifacts
coverage/
.nyc_output/
*.lcov

# OMC artifacts (ask / ccg outputs are session-local)
.omc/

# OMC dispatch scratch — codex prompt drafts (per CLAUDE.md #11 clean-room)
docs/plans/.codex-prompt-*.md

# Fingerprint collector output — operator-local 私有数据；按 README 承诺
# "ships with no fingerprint templates"，公开仓库不应携带任何 captured
# template / pcap / JA3 / JA4 / metadata。Operator 自行采集后放本地配置目录。
tools/fingerprint-collector/output/
tools/fingerprint-collector/fpc.exe
tools/fingerprint-collector/fpc
