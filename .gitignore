# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors / IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json.example
*.swp
*.swo

# Local agent / CLI state (must never be committed)
.claude/settings.local.json
.gemini/settings.local.json
.codex/local/

# Secrets & env
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/
credentials.json

# Build output (placeholder for future phases)
dist/
build/
out/
target/
bin/
*.exe
*.bin
*.test
node_modules/
vendor/
.venv/
__pycache__/
*.pyc

# Generated code (sqlc — regenerate via `make generate`)
# NOTE: We DO track backend/internal/db/db.go (Phase 3/4-bridge stub) so a
# fresh clone compiles. Phase 4 implementer-lane deletes that stub and lets
# sqlc-generated files appear here.
backend/internal/db/*
!backend/internal/db/db.go

# Operator config (never commit; only config.example.yaml is tracked)
backend/config.yaml
!backend/config.example.yaml

# Frontend build artifacts (Phase 7+)
frontend/node_modules/
frontend/dist/
frontend/.next/
frontend/build/

# Logs & runtime
*.log
logs/
tmp/
temp/

# Coverage / test artifacts
coverage/
.nyc_output/
*.lcov

# OMC artifacts (ask / ccg outputs are session-local)
.omc/
